<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ presentation_title }}</title>
  <style>
    :root {
      --bg: #f4f3ef;
      --bg-tint: #eae8e2;
      --fg: #121212;
      --muted: #5a5a56;
      --accent: #0057ff;
      --accent-soft: #3d7dff;
      --accent-dim: rgba(0, 87, 255, 0.12);
      --line: #cfcbc4;
      --overlay: rgba(8, 8, 12, 0.68);
      --font: "Segoe UI", system-ui, -apple-system, sans-serif;
      --bar-h: 68px;
      --slide-margin: 5%;
      --radius: 6px;
      --shadow: 0 8px 28px rgba(18, 18, 18, 0.08);
      --content-pad-x: clamp(20px, 3vw, 52px);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: var(--font);
      background: #000;
      color: var(--fg);
      user-select: none;
    }

    #deck {
      position: relative;
      width: 100vw;
      height: 100vh;
      overflow: hidden;
    }

    .slide {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.35s ease;
    }

    .slide.active {
      opacity: 1;
      pointer-events: auto;
      z-index: 2;
    }

    /* 5% поля от края экрана (над progress-bar) */
    .slide-margin-box {
      position: absolute;
      top: var(--slide-margin);
      left: var(--slide-margin);
      right: var(--slide-margin);
      bottom: calc(var(--bar-h) + var(--slide-margin));
      display: flex;
      flex-direction: column;
      overflow: hidden;
      min-height: 0;
      border-radius: calc(var(--radius) + 2px);
      box-shadow: var(--shadow);
    }

    .slide-fit-host {
      flex: 1 1 auto;
      min-height: 0;
      width: 100%;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
    }

    .slide-fit-content {
      width: 100%;
      max-width: 100%;
      transform-origin: top center;
      will-change: transform;
    }

    /* демо-слайды: видео/картинка занимают оставшуюся высоту */
    .slide.demo .slide-fit-content {
      flex: 1 1 auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
    }

    .slide.demo .demo-body {
      flex: 1 1 auto;
      min-height: 0;
    }

    .slide.demo .demo-media {
      flex: 1 1 auto;
      min-height: min(32vh, 280px);
    }

    .slide.demo .demo-media video {
      width: 100%;
      max-width: 100%;
      height: auto;
      min-height: min(32vh, 280px);
      max-height: 100%;
      aspect-ratio: 16 / 9;
      object-fit: contain;
      cursor: pointer;
    }

    .slide.demo .demo-media img {
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      cursor: zoom-in;
    }

    /* —— полноэкранный просмотр изображений —— */
    .media-viewer {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(6, 6, 10, 0.88);
      backdrop-filter: blur(10px);
      padding: 2vh 2vw;
    }

    .media-viewer[hidden] {
      display: none !important;
    }

    .media-viewer-close {
      position: absolute;
      top: 1.2vh;
      right: 1.5vw;
      z-index: 1;
      width: 48px;
      height: 48px;
      border: 2px solid rgba(255, 255, 255, 0.35);
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.45);
      color: #fff;
      font-size: 28px;
      line-height: 1;
      cursor: pointer;
    }

    .media-viewer-close:hover {
      border-color: #fff;
      background: rgba(0, 0, 0, 0.65);
    }

    .media-viewer-img,
    .media-viewer-video {
      max-width: 96vw;
      max-height: 92vh;
      object-fit: contain;
      border: 2px solid rgba(255, 255, 255, 0.2);
      background: #111;
    }

    .media-viewer-video {
      width: auto;
      height: auto;
      aspect-ratio: 16 / 9;
    }

    /* —— шапка проекта + шаги —— */
    .talk-header {
      flex: 0 0 auto;
      padding: 0 var(--content-pad-x) 1vh;
      border-bottom: 3px solid var(--fg);
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.55) 0%, transparent 100%),
        var(--bg);
      position: relative;
    }

    .talk-header::after {
      content: "";
      position: absolute;
      left: var(--content-pad-x);
      bottom: -3px;
      width: min(28%, 220px);
      height: 3px;
      background: var(--fg);
    }

    .talk-identity {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.35em 1.5em;
    }

    .project-title {
      font-size: clamp(20px, 2.85vw, 38px);
      font-weight: 900;
      line-height: 1.06;
      letter-spacing: -0.025em;
    }

    .talk-titles {
      flex: 1 1 auto;
      min-width: 0;
    }

    .project-author {
      font-size: clamp(13px, 1.5vw, 22px);
      font-weight: 600;
      color: var(--fg);
      white-space: nowrap;
      flex: 0 0 auto;
    }

    .talk-step {
      display: block;
      margin: 0.3em 0 0;
      font-size: clamp(11px, 1.25vw, 20px);
      font-weight: 700;
      color: var(--fg);
      letter-spacing: 0.02em;
      line-height: 1.2;
      text-transform: none;
    }

    /* —— контентные слайды —— */
    .slide.content {
      background:
        radial-gradient(120% 80% at 100% 0%, var(--accent-dim) 0%, transparent 55%),
        linear-gradient(165deg, var(--bg) 0%, var(--bg-tint) 100%);
    }

    .slide-body {
      flex: 0 0 auto;
      overflow: hidden;
      padding: 1.2vh var(--content-pad-x) 0.6vh;
      font-size: clamp(13px, 1.5vw, 22px);
      line-height: 1.48;
      max-width: 100%;
      color: var(--fg);
    }

    .slide-body ul, .slide-body ol { margin: 0.55em 0 0.55em 1.15em; }
    .slide-body li { margin: 0.3em 0; }
    .slide-body li::marker { color: var(--fg); }
    .slide-body p { margin: 0.45em 0; }
    .slide-body strong { font-weight: 800; color: var(--fg); }
    .slide-body a {
      color: var(--fg);
      text-decoration: underline;
      text-underline-offset: 0.12em;
    }
    .slide-body code {
      font-size: 0.92em;
      padding: 0.08em 0.35em;
      border-radius: 4px;
      background: rgba(18, 18, 18, 0.06);
      border: 1px solid var(--line);
      color: var(--fg);
    }

    .slide-body img,
    .slide-body svg {
      display: block;
      max-width: 100%;
      max-height: 42vh;
      height: auto;
      width: auto;
      margin: 0.7em auto;
      border: 2px solid var(--line);
      border-radius: var(--radius);
      background: #fff;
      box-shadow: var(--shadow);
      cursor: zoom-in;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .slide-body img:hover,
    .slide-body svg:hover {
      border-color: var(--accent-soft);
      box-shadow: 0 10px 32px rgba(0, 87, 255, 0.12);
    }

    .slide-body video {
      display: block;
      max-width: 100%;
      max-height: 42vh;
      height: auto;
      width: 100%;
      margin: 0.7em auto;
      border: 2px solid var(--line);
      border-radius: var(--radius);
      background: #111;
      box-shadow: var(--shadow);
      aspect-ratio: 16 / 9;
      object-fit: contain;
      cursor: pointer;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .slide-body video:hover {
      border-color: var(--accent-soft);
      box-shadow: 0 10px 32px rgba(0, 87, 255, 0.12);
    }

    .slide-body .media-row {
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      gap: clamp(12px, 2vw, 28px);
      margin: 0.6em 0;
      width: 100%;
      align-items: stretch;
      justify-content: center;
    }

    .slide-body .media-row .media-cell {
      flex: 1 1 0;
      min-width: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .slide-body .media-row .media-cell img {
      margin: 0;
      width: 100%;
      height: auto;
      max-height: min(48vh, 500px);
      object-fit: contain;
    }

    .slide-body .media-row:has(.media-cell:only-child) .media-cell {
      flex: 0 1 72%;
    }

    .slide-body table { border-collapse: collapse; margin: 0.85em 0; font-size: 0.88em; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow); }
    .slide-body th, .slide-body td { border: 1px solid var(--line); padding: 0.4em 0.7em; }
    .slide-body th { background: var(--fg); color: var(--bg); font-weight: 700; }
    .slide-body tr:nth-child(even) td { background: rgba(255, 255, 255, 0.45); }

    /* —— слайд «?» (Q&A) —— */
    .slide.qa {
      background:
        radial-gradient(120% 80% at 50% 0%, var(--accent-dim) 0%, transparent 55%),
        linear-gradient(165deg, var(--bg) 0%, var(--bg-tint) 100%);
    }

    .slide-qa-box {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .slide-qa-mark {
      font-size: clamp(96px, 24vw, 360px);
      font-weight: 900;
      line-height: 1;
      color: var(--fg);
      letter-spacing: -0.04em;
      user-select: none;
    }

    /* —— демо (тот же светлый стиль, что и content) —— */
    .slide.demo {
      background:
        radial-gradient(120% 80% at 0% 100%, var(--accent-dim) 0%, transparent 50%),
        linear-gradient(165deg, var(--bg) 0%, var(--bg-tint) 100%);
      color: var(--fg);
    }

    .demo-body {
      flex: 1 1 auto;
      min-height: 0;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      max-width: 100%;
    }

    .demo-intro {
      flex: 0 0 auto;
      color: var(--fg);
      font-size: clamp(11px, 1.25vw, 18px);
      line-height: 1.38;
      margin-bottom: 0.7vh;
      overflow: hidden;
      padding: 0 var(--content-pad-x);
    }

    .demo-intro:empty { display: none; }

    .demo-intro p { margin: 0.35em 0; }
    .demo-intro li::marker { color: var(--fg); }
    .demo-intro a { color: var(--fg); text-decoration: underline; }
    .demo-intro code {
      color: var(--fg);
      background: rgba(18, 18, 18, 0.06);
      border: 1px solid var(--line);
      border-radius: 4px;
      padding: 0.08em 0.35em;
    }

    .demo-media {
      flex: 1 1 0;
      min-height: 0;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .demo-media img,
    .demo-media video {
      display: block;
      border: 2px solid var(--line);
      border-radius: var(--radius);
      background: #fff;
      box-shadow: var(--shadow);
    }

    .demo-media video {
      background: #111;
    }

    /* —— welcome / questions —— */
    .slide.cinematic {
      color: #fff;
      align-items: stretch;
      justify-content: flex-start;
    }

    .bg-video-stack {
      position: absolute;
      inset: 0;
      z-index: 0;
      overflow: hidden;
      background: #000;
    }

    .bg-video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      z-index: 0;
      transition: none;
      pointer-events: none;
    }

    /* нижний слой — всегда на полной яркости */
    .bg-video.is-base {
      opacity: 1;
      z-index: 1;
    }

    /* верхний слой — только проявление 0→1, без затухания нижнего */
    .bg-video.is-overlay {
      z-index: 2;
      opacity: 0;
      transition: opacity 1s ease-in-out;
      will-change: opacity;
    }

    .bg-video.is-overlay.reveal {
      opacity: 1;
    }

    .cinematic-banner {
      position: absolute;
      top: var(--slide-margin);
      left: var(--slide-margin);
      right: var(--slide-margin);
      z-index: 2;
      background: rgba(8, 8, 14, 0.78);
      border-bottom: 3px solid rgba(255, 255, 255, 0.15);
      padding: 2.2vh 2vw 2.4vh;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      overflow: hidden;
    }

    .cinematic-content {
      max-width: 1100px;
      width: 100%;
      margin: 0 auto;
      text-align: center;
    }

    .cinematic h1 {
      font-size: clamp(22px, 3.6vw, 54px);
      font-weight: 900;
      line-height: 1.08;
      margin-bottom: 0.2em;
      text-shadow: 0 2px 24px rgba(0, 0, 0, 0.45);
    }

    .cinematic .subtitle {
      font-size: clamp(14px, 1.65vw, 24px);
      font-weight: 500;
      color: #e8e8e8;
      text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
    }

    .cinematic-mark {
      font-size: clamp(120px, 28vw, 420px);
      font-weight: 900;
      line-height: 1;
      letter-spacing: -0.04em;
      color: #fff;
      text-shadow: 0 4px 32px rgba(0, 0, 0, 0.5);
    }

    .cinematic-mark-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
    }

    .slide.cinematic-qa .cinematic-banner {
      top: var(--slide-margin);
      left: var(--slide-margin);
      right: var(--slide-margin);
      bottom: calc(var(--bar-h) + var(--slide-margin));
      border-bottom: none;
      background: rgba(8, 8, 14, 0.52);
    }

    .hint {
      position: fixed;
      bottom: 58px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 20;
      font-size: 12px;
      color: rgba(255, 255, 255, 0.45);
      pointer-events: none;
    }

    #progress-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 30;
      background: linear-gradient(180deg, rgba(18, 18, 18, 0.82) 0%, rgba(8, 8, 10, 0.96) 100%);
      backdrop-filter: blur(8px);
      color: #fff;
      padding: 8px 18px 10px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      height: var(--bar-h);
      justify-content: center;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    #progress-track {
      width: 100%;
      height: 4px;
      background: rgba(255, 255, 255, 0.16);
      border-radius: 999px;
      overflow: hidden;
    }

    #progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, var(--accent), var(--accent-soft));
      transition: width 0.3s ease;
      border-radius: 999px;
    }

    #progress-meta {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      font-size: 13px;
      font-weight: 600;
    }

    #progress-label { color: #ccc; }
    #progress-count { color: #fff; font-variant-numeric: tabular-nums; }

  </style>
</head>
<body>
  <div id="deck" aria-live="polite"></div>
  <div class="hint">Колесо / стрелки · клик по медиа — на весь экран · F11</div>

  <div id="progress-bar">
    <div id="progress-track"><div id="progress-fill"></div></div>
    <div id="progress-meta">
      <span id="progress-label">—</span>
      <span id="progress-count">0 / 0</span>
    </div>
  </div>

  <div id="media-viewer" class="media-viewer" hidden aria-hidden="true">
    <button type="button" class="media-viewer-close" aria-label="Закрыть">&times;</button>
    <img class="media-viewer-img" alt="" hidden>
    <video class="media-viewer-video" controls playsinline hidden></video>
  </div>

  <script>
    const SLIDES = {{ slides_json | safe }};

    const deck = document.getElementById('deck');
    const progressFill = document.getElementById('progress-fill');
    const progressLabel = document.getElementById('progress-label');
    const progressCount = document.getElementById('progress-count');
    const mediaViewer = document.getElementById('media-viewer');
    const mediaViewerImg = mediaViewer.querySelector('.media-viewer-img');
    const mediaViewerVideo = mediaViewer.querySelector('.media-viewer-video');
    const mediaViewerClose = mediaViewer.querySelector('.media-viewer-close');

    let index = 0;
    let wheelLocked = false;
    const BG_CROSSFADE_MS = 1000;

    function isMediaViewerOpen() {
      return !mediaViewer.hidden;
    }

    function closeMediaViewer() {
      mediaViewer.hidden = true;
      mediaViewer.setAttribute('aria-hidden', 'true');
      mediaViewerVideo.pause();
      mediaViewerVideo.removeAttribute('src');
      mediaViewerVideo.load();
      mediaViewerVideo.hidden = true;
      mediaViewerImg.removeAttribute('src');
      mediaViewerImg.hidden = true;
    }

    function openMediaViewer(src, kind, opts = {}) {
      if (!src) return;
      mediaViewer.hidden = false;
      mediaViewer.setAttribute('aria-hidden', 'false');
      if (kind === 'video') {
        mediaViewerImg.hidden = true;
        mediaViewerVideo.hidden = false;
        mediaViewerVideo.src = src;
        if (typeof opts.currentTime === 'number') {
          mediaViewerVideo.currentTime = opts.currentTime;
        }
        if (opts.autoplay) {
          mediaViewerVideo.play().catch(() => {});
        }
      } else {
        mediaViewerVideo.hidden = true;
        mediaViewerImg.hidden = false;
        mediaViewerImg.src = src;
      }
    }

    function setupMediaViewer() {
      deck.addEventListener('click', (e) => {
        const img = e.target.closest('.slide-body img, .demo-media img, .demo-intro img');
        if (img && deck.contains(img)) {
          e.preventDefault();
          e.stopPropagation();
          openMediaViewer(img.currentSrc || img.src, 'img');
          return;
        }

        const video = e.target.closest('.slide-body video, .demo-media video');
        if (video && deck.contains(video) && !video.classList.contains('bg-video')) {
          e.preventDefault();
          e.stopPropagation();
          openMediaViewer(video.currentSrc || video.src, 'video', {
            currentTime: video.currentTime,
            autoplay: !video.paused,
          });
        }
      });

      mediaViewerClose.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        closeMediaViewer();
      });

      mediaViewer.addEventListener('click', (e) => {
        if (e.target === mediaViewer) closeMediaViewer();
      });
    }

    function escapeHtml(s) {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function renderTalkHeader(data, sectionTitle) {
      const author = data.author
        ? `<p class="project-author">${escapeHtml(data.author)}</p>`
        : '';
      const step = sectionTitle
        ? `<p class="talk-step">${escapeHtml(sectionTitle)}</p>`
        : '';
      return `
        <header class="talk-header">
          <div class="talk-identity">
            <div class="talk-titles">
              <h1 class="project-title">${escapeHtml(data.block_title || '')}</h1>
              ${step}
            </div>
            ${author}
          </div>
        </header>
      `;
    }

    function renderSlide(data, i) {
      const el = document.createElement('section');
      el.className = 'slide';
      el.dataset.index = String(i);

      if (data.type === 'welcome') {
        el.classList.add('cinematic');
        el.innerHTML = `
          <div class="bg-video-stack" aria-hidden="true">
            <video class="bg-video bg-video-a" muted playsinline preload="auto"></video>
            <video class="bg-video bg-video-b" muted playsinline preload="auto"></video>
          </div>
          <div class="cinematic-banner">
            <div class="cinematic-content cinematic">
              <h1>${escapeHtml(data.title || '')}</h1>
              ${data.subtitle ? `<p class="subtitle">${escapeHtml(data.subtitle)}</p>` : ''}
            </div>
          </div>
        `;
        el.dataset.videos = JSON.stringify(data.videos || []);
        return el;
      }

      if (data.type === 'questions') {
        el.classList.add('cinematic', 'cinematic-qa');
        el.innerHTML = `
          <div class="bg-video-stack" aria-hidden="true">
            <video class="bg-video bg-video-a" muted playsinline preload="auto"></video>
            <video class="bg-video bg-video-b" muted playsinline preload="auto"></video>
          </div>
          <div class="cinematic-banner">
            <div class="cinematic-mark-wrap">
              <p class="cinematic-mark" aria-label="Вопросы">?</p>
            </div>
          </div>
        `;
        el.dataset.videos = JSON.stringify(data.videos || []);
        return el;
      }

      if (data.type === 'qa') {
        el.classList.add('qa');
        el.innerHTML = `
          <div class="slide-margin-box slide-qa-box">
            <p class="slide-qa-mark" aria-label="Вопросы">?</p>
          </div>
        `;
        return el;
      }

      if (data.type === 'demo') {
        el.classList.add('demo');
        const media = data.mime === 'video'
          ? `<video src="${data.src}" controls playsinline preload="metadata"></video>`
          : data.mime === 'image'
            ? `<img src="${data.src}" alt="Демо ${data.index}">`
            : `<p>Нет медиа</p>`;
        const demoTitle = data.total > 1
          ? `Демо ${data.index} / ${data.total}`
          : 'Демо';
        el.innerHTML = `
          <div class="slide-margin-box">
            <div class="slide-fit-host">
              <div class="slide-fit-content">
                ${renderTalkHeader(data, demoTitle)}
                <div class="slide-body demo-body">
                  <div class="demo-intro">${data.intro_html || ''}</div>
                  <div class="demo-media">${media}</div>
                </div>
              </div>
            </div>
          </div>
        `;
        return el;
      }

      el.classList.add('content');
      el.innerHTML = `
        <div class="slide-margin-box">
          <div class="slide-fit-host">
            <div class="slide-fit-content">
              ${renderTalkHeader(data, data.section_title || '')}
              <div class="slide-body">${data.html || ''}</div>
            </div>
          </div>
        </div>
      `;
      return el;
    }

    function buildDeck() {
      SLIDES.forEach((s, i) => deck.appendChild(renderSlide(s, i)));
    }

    /** Подгонка контента слайда в область с 5% полями без прокрутки. */
    function fitSlideContent(slideEl) {
      const host = slideEl.querySelector('.slide-fit-host');
      const content = slideEl.querySelector('.slide-fit-content');
      if (host && content) {
        content.style.transform = 'none';

        const boxW = host.clientWidth;
        const boxH = host.clientHeight;
        if (boxW <= 0 || boxH <= 0) return;

        const naturalH = content.scrollHeight;
        const naturalW = content.scrollWidth;
        const scale = Math.min(1, boxH / naturalH, boxW / naturalW);

        if (scale < 0.999) {
          content.style.transform = `scale(${scale})`;
          content.style.transformOrigin = 'top center';
        }
        return;
      }

      const banner = slideEl.querySelector('.cinematic-banner');
      const cinematic = slideEl.querySelector('.cinematic-content');
      if (!banner || !cinematic) return;

      cinematic.style.transform = 'none';
      const title = cinematic.querySelector('h1');
      const subtitle = cinematic.querySelector('.subtitle');
      if (title) title.style.fontSize = '';
      if (subtitle) subtitle.style.fontSize = '';

      const maxH = banner.clientHeight;
      if (maxH <= 0) return;

      let scale = 1;
      const minScale = 0.55;
      cinematic.style.transform = 'scale(1)';

      while (cinematic.scrollHeight > maxH && scale > minScale) {
        scale *= 0.92;
        cinematic.style.transform = `scale(${scale})`;
        cinematic.style.transformOrigin = 'top center';
      }
    }

    function fitAllSlides() {
      deck.querySelectorAll('.slide').forEach((slide) => fitSlideContent(slide));
    }

    let fitScheduled = false;
    function scheduleFit() {
      if (fitScheduled) return;
      fitScheduled = true;
      requestAnimationFrame(() => {
        fitScheduled = false;
        fitAllSlides();
      });
    }

    function stopBgVideo() {
      deck.querySelectorAll('.slide.cinematic').forEach((slide) => {
        if (typeof slide._bgStop === 'function') slide._bgStop();
      });
    }

    function startBgRotation(slideEl) {
      stopBgVideo();
      const raw = slideEl.dataset.videos;
      if (!raw) return;
      const urls = JSON.parse(raw);
      if (!urls.length) return;

      const stack = slideEl.querySelector('.bg-video-stack');
      const layers = stack ? Array.from(stack.querySelectorAll('.bg-video')) : [];
      if (layers.length < 2) return;

      let front = 0;
      let back = 1;
      let currentIdx = Math.floor(Math.random() * urls.length);
      let transitioning = false;
      let stopped = false;

      function resetLayerClasses(v) {
        v.classList.remove('is-base', 'is-overlay', 'reveal', 'visible');
      }

      layers.forEach((v) => {
        v.muted = true;
        v.playsInline = true;
        v.loop = false;
        v.preload = 'auto';
        resetLayerClasses(v);
      });

      function pickNextIdx() {
        if (urls.length === 1) return 0;
        let next;
        do {
          next = Math.floor(Math.random() * urls.length);
        } while (next === currentIdx);
        return next;
      }

      function waitReady(video) {
        return new Promise((resolve) => {
          if (video.readyState >= 4) {
            resolve();
            return;
          }
          const done = () => {
            video.removeEventListener('canplaythrough', done);
            video.removeEventListener('canplay', done);
            video.removeEventListener('error', done);
            resolve();
          };
          video.addEventListener('canplaythrough', done);
          video.addEventListener('canplay', done);
          video.addEventListener('error', done);
        });
      }

      function loadInto(video, idx) {
        const url = urls[idx];
        if (video.dataset.src !== url) {
          video.dataset.src = url;
          video.src = url;
          video.load();
        } else {
          video.currentTime = 0;
        }
        return waitReady(video).then(() => video.play().catch(() => {}));
      }

      function revealOverlay(overlayEl) {
        overlayEl.classList.add('is-overlay');
        overlayEl.classList.remove('reveal');
        void overlayEl.offsetWidth;
        requestAnimationFrame(() => {
          requestAnimationFrame(() => overlayEl.classList.add('reveal'));
        });
      }

      function bindAdvanceHandlers(active) {
        active.onended = () => crossfadeToNext();
        active.ontimeupdate = () => {
          const dur = active.duration;
          if (!dur || dur < 2) return;
          if (active.currentTime >= dur - 1.2) {
            active.ontimeupdate = null;
            crossfadeToNext();
          }
        };
      }

      async function crossfadeToNext() {
        if (stopped || transitioning) return;
        transitioning = true;

        const frontEl = layers[front];
        const backEl = layers[back];
        const nextIdx = pickNextIdx();

        frontEl.onended = null;
        frontEl.ontimeupdate = null;

        resetLayerClasses(backEl);
        await loadInto(backEl, nextIdx);
        if (stopped) {
          transitioning = false;
          return;
        }

        /* нижний слой остаётся на 100% — верхний плавно накрывает */
        revealOverlay(backEl);

        window.setTimeout(() => {
          if (stopped) return;
          resetLayerClasses(frontEl);
          frontEl.pause();
          frontEl.removeAttribute('src');
          delete frontEl.dataset.src;
          frontEl.load();

          resetLayerClasses(backEl);
          backEl.classList.add('is-base');

          currentIdx = nextIdx;
          [front, back] = [back, front];
          bindAdvanceHandlers(layers[front]);
          transitioning = false;
        }, BG_CROSSFADE_MS + 50);
      }

      slideEl._bgStop = () => {
        stopped = true;
        layers.forEach((v) => {
          v.onended = null;
          v.ontimeupdate = null;
          v.pause();
          v.removeAttribute('src');
          delete v.dataset.src;
          resetLayerClasses(v);
          v.load();
        });
        delete slideEl._bgStop;
      };

      (async () => {
        const first = layers[0];
        await loadInto(first, currentIdx);
        if (stopped) return;
        first.classList.add('is-base');
        bindAdvanceHandlers(first);
      })();
    }

    function pauseInactiveMedia() {
      deck.querySelectorAll('video').forEach(v => {
        if (!v.classList.contains('bg-video')) v.pause();
      });
    }

    function pauseDemoVideos(slideEl) {
      slideEl.querySelectorAll('.demo-media video').forEach((v) => {
        v.pause();
      });
    }

    function updateUI() {
      const nodes = deck.querySelectorAll('.slide');
      nodes.forEach((n, i) => n.classList.toggle('active', i === index));

      const current = SLIDES[index] || {};
      stopBgVideo();

      const activeEl = nodes[index];
      if (activeEl) {
        if (current.type === 'welcome' || current.type === 'questions') {
          startBgRotation(activeEl);
        } else if (current.type === 'demo') {
          /* демо-видео с controls — не автозапуск; первый кадр через preload=metadata */
        }
      }

      const total = SLIDES.length;
      progressFill.style.width = (total ? ((index + 1) / total) * 100 : 0) + '%';

      let label = current.block_title || current.title || 'Выступление';
      if (current.type === 'qa') {
        label += ' — ?';
      } else if (current.section_title) {
        label += ' — ' + current.section_title;
      }
      if (current.type === 'demo') label += ' · демо ' + current.index;
      progressLabel.textContent = label;
      progressCount.textContent = (index + 1) + ' / ' + total;
      scheduleFit();
    }

    function go(delta) {
      const next = index + delta;
      if (next < 0 || next >= SLIDES.length) return;
      pauseInactiveMedia();
      index = next;
      updateUI();
    }

    document.addEventListener('wheel', (e) => {
      if (isMediaViewerOpen()) return;
      if (Math.abs(e.deltaY) < 8) return;
      e.preventDefault();
      if (wheelLocked) return;
      wheelLocked = true;
      setTimeout(() => { wheelLocked = false; }, 380);
      go(e.deltaY > 0 ? 1 : -1);
    }, { passive: false });

    document.addEventListener('keydown', (e) => {
      if (isMediaViewerOpen()) {
        if (e.key === 'Escape') {
          e.preventDefault();
          closeMediaViewer();
        }
        return;
      }
      if (e.key === 'ArrowRight' || e.key === 'PageDown' || e.key === ' ') {
        e.preventDefault();
        go(1);
      }
      if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
        e.preventDefault();
        go(-1);
      }
      if (e.key === 'Home') { index = 0; updateUI(); }
      if (e.key === 'End') { index = SLIDES.length - 1; updateUI(); }
    });

    buildDeck();
    setupMediaViewer();
    updateUI();
    scheduleFit();

    window.addEventListener('resize', scheduleFit);

    deck.querySelectorAll('.slide img, .slide video').forEach((media) => {
      const refit = () => scheduleFit();
      media.addEventListener('load', refit);
      media.addEventListener('loadedmetadata', refit);
      media.addEventListener('loadeddata', refit);
    });
  </script>
</body>
</html>
